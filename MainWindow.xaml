<Window x:Class="WMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WMS — Система управления складом"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Grid.Column="0" Background="#2C3E50">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16">
                    <TextBlock Text="WMS" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding CurrentUserName}" Foreground="#BDC3C7" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentUserRole}" Foreground="#95A5A6" FontSize="12"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Command="{Binding NavigateCommand}"
                                        HorizontalContentAlignment="Left"
                                        Padding="16,10"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="White"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#34495E"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3D566E"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Область контента -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="16"/>
    </Grid>
</Window>