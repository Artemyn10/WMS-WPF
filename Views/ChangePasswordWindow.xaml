<Window x:Class="WMS.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Текущий пароль"/>
        <PasswordBox x:Name="CurrentPasswordBox" Padding="4" Margin="0,4,0,10"
                     PasswordChanged="CurrentPasswordBox_OnPasswordChanged"/>

        <TextBlock Text="Новый пароль"/>
        <PasswordBox x:Name="NewPasswordBox" Padding="4" Margin="0,4,0,0"
                     PasswordChanged="NewPasswordBox_OnPasswordChanged"/>
        <TextBlock Text="Не менее 6 символов" FontSize="11" Foreground="Gray" Margin="0,2,0,10"/>

        <TextBlock Text="Повторите новый пароль"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Padding="4" Margin="0,4,0,10"
                     PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
</Window>