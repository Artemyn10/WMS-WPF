<UserControl x:Class="WMS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Остатки" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

            <TextBlock Text="Товар:" VerticalAlignment="Center" Margin="24,0,0,0"/>
            <TextBox Width="200" Margin="8,0,0,0" Padding="4"
                     Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"/>

            <TextBlock Text="Ячейка:" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBox Width="140" Margin="8,0,0,0" Padding="4"
                     Text="{Binding LocationSearch, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding InventoryRecords}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Product.Article}" Width="110"/>
                <DataGridTextColumn Header="Склад" Binding="{Binding StorageLocation.Warehouse.Name}" Width="150"/>
                <DataGridTextColumn Header="Ячейка" Binding="{Binding StorageLocation.Code}" Width="110"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>