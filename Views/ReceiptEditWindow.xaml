<Window x:Class="WMS.Views.ReceiptEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая приёмка"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Width="260" Margin="0,0,16,0">
                <TextBlock Text="Поставщик"/>
                <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedSupplier}" Padding="4" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Width="200" Margin="0,0,16,0">
                <TextBlock Text="Склад"/>
                <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedWarehouse}" Padding="4" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Width="140">
                <TextBlock Text="Номер документа"/>
                <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Товары в приёмке" FontWeight="Bold" FontSize="14"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Товар" Width="320" FontWeight="Bold"/>
            <TextBlock Text="Количество" Width="100" FontWeight="Bold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox Width="320" ItemsSource="{Binding AvailableProducts}"
                                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedProduct}"
                                      Padding="4"/>
                            <TextBox Width="100" Margin="8,0,0,0" Padding="4"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Удалить" Margin="8,0,0,0" Padding="8,4"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="8" Content="+ Добавить товар" HorizontalAlignment="Left"
                Margin="0,8,0,0" Padding="12,4" Command="{Binding AddItemCommand}"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Подтвердить приёмку" Width="160" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="12" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
    </Grid>
</Window>