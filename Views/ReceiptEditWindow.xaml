<Window x:Class="WMS.Views.ReceiptEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая приёмка"
        Height="680" Width="700"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">

        <!-- Низ окна: кнопки и ошибка -->
        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Подтвердить приёмку" Width="170" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Верх окна: шапка документа -->
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="250" Margin="0,0,16,0">
                    <TextBlock Text="Поставщик"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSupplier}" Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="200" Margin="0,0,16,0">
                    <TextBlock Text="Склад"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedWarehouse}" Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="140">
                    <TextBlock Text="Номер документа"/>
                    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel Width="170" Margin="0,0,16,0">
                    <TextBlock Text="Дата поступления"/>
                    <DatePicker SelectedDate="{Binding ArrivalDate, Mode=TwoWay}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="420">
                    <TextBlock Text="Заказ поставщику (необязательно)"/>
                    <ComboBox ItemsSource="{Binding PurchaseOrders}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedPurchaseOrder}" Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Показываются открытые заказы выбранного поставщика на выбранный склад. При выборе заказа строки заполняются оставшимся к получению количеством."/>

            <TextBlock Text="Товары в приёмке" FontWeight="Bold" FontSize="14" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Товар" Width="320" FontWeight="Bold"/>
                <TextBlock Text="Количество" Width="100" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Кнопка добавления строки -->
        <Button DockPanel.Dock="Bottom" Content="+ Добавить товар" HorizontalAlignment="Left"
                Margin="0,8,0,0" Padding="12,4" Command="{Binding AddItemCommand}"/>

        <!-- Список товаров занимает всё оставшееся место -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox Width="320" ItemsSource="{Binding AvailableProducts}"
                                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedProduct}"
                                      Padding="4"/>
                            <TextBox Width="100" Margin="8,0,0,0" Padding="4"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Удалить" Margin="8,0,0,0" Padding="8,4"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>