<UserControl x:Class="WMS.Views.PickingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Комплектация" FontSize="20" FontWeight="Bold"/>

        <TextBlock Grid.Row="0" Text="Нет заказов, ожидающих комплектации."
                   FontSize="14" Foreground="Gray" HorizontalAlignment="Right"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="90"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Customer.Name}" Width="*"/>
                <DataGridTextColumn Header="Склад" Binding="{Binding Warehouse.Name}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="Позиции для сборки" FontWeight="Bold" Margin="0,4,0,0"/>

        <DataGrid Grid.Row="5" ItemsSource="{Binding PendingItems}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="100"/>
                <DataGridTextColumn Header="Нужно" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Собрано" Binding="{Binding PickedQuantity}" Width="80"/>
                <DataGridTextColumn Header="Осталось" Binding="{Binding Remaining}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="6" Margin="0,12,0,0" Padding="12"
                BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Сборка выбранной позиции" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Width="300">
                        <TextBlock Text="Ячейка-источник"/>
                        <ComboBox ItemsSource="{Binding Locations}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedLocation}" Padding="4" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Width="100" Margin="16,0,0,0">
                        <TextBlock Text="Количество"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="Собрать" Margin="16,0,0,0" Padding="16,5"
                            VerticalAlignment="Bottom" Command="{Binding PickCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>