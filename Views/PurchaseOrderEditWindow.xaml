<Window x:Class="WMS.Views.PurchaseOrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый заказ поставщику"
        Height="620" Width="700"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">

        <!-- Низ окна: кнопки и ошибка -->
        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Оформить заказ" Width="140" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Верх окна: шапка заказа -->
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="250" Margin="0,0,16,0">
                    <TextBlock Text="Поставщик"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSupplier}" Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="200" Margin="0,0,16,0">
                    <TextBlock Text="Склад поставки"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedWarehouse}" Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="140">
                    <TextBlock Text="Номер заказа"/>
                    <TextBox Text="{Binding OrderNumber, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel Width="250" Margin="0,0,16,0">
                    <TextBlock Text="Ожидаемая дата поставки"/>
                    <DatePicker SelectedDate="{Binding ExpectedDate, Mode=TwoWay}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="356">
                    <TextBlock Text="Комментарий (необязательно)"/>
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Товары в заказе" FontWeight="Bold" FontSize="14" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Товар" Width="320" FontWeight="Bold"/>
                <TextBlock Text="Количество" Width="100" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Кнопка добавления строки -->
        <Button DockPanel.Dock="Bottom" Content="+ Добавить товар" HorizontalAlignment="Left"
                Margin="0,8,0,0" Padding="12,4" Command="{Binding AddItemCommand}"/>

        <!-- Список товаров занимает всё оставшееся место -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox Width="320" ItemsSource="{Binding AvailableProducts}"
                                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedProduct}"
                                      Padding="4"/>
                            <TextBox Width="100" Margin="8,0,0,0" Padding="4"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Удалить" Margin="8,0,0,0" Padding="8,4"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>