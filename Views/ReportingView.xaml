<UserControl x:Class="WMS.Views.ReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Отчётность"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Width="180" Margin="0,0,12,8">
                <TextBlock Text="Склад"/>
                <ComboBox Margin="0,4,0,0"
                          ItemsSource="{Binding Warehouses}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedWarehouse}"/>
            </StackPanel>

            <StackPanel Width="150" Margin="0,0,12,8">
                <TextBlock Text="Дата с"/>
                <DatePicker Margin="0,4,0,0"
                            SelectedDate="{Binding FromDate}"/>
            </StackPanel>

            <StackPanel Width="150" Margin="0,0,12,8">
                <TextBlock Text="Дата по"/>
                <DatePicker Margin="0,4,0,0"
                            SelectedDate="{Binding ToDate}"/>
            </StackPanel>

            <Button Content="Обновить"
                    Padding="12,5"
                    Margin="0,20,8,8"
                    Command="{Binding RefreshCommand}"/>

            <Button Content="Экспорт в Excel (CSV)"
                    Padding="12,5"
                    Margin="0,20,8,8"
                    Command="{Binding ExportCsvCommand}"/>

            <Button Content="Печать / PDF"
                    Padding="12,5"
                    Margin="0,20,8,8"
                    Click="PrintReport_Click"/>
        </WrapPanel>

        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedReportIndex}">
            <TabItem Header="Остатки">
                <DataGrid ItemsSource="{Binding StockRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Склад"
                                            Binding="{Binding WarehouseName}"
                                            Width="170"/>
                        <DataGridTextColumn Header="Артикул"
                                            Binding="{Binding Article}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Товар"
                                            Binding="{Binding ProductName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Quantity}"
                                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Поступления и отгрузки">
                <DataGrid ItemsSource="{Binding ActivityRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Операция"
                                            Binding="{Binding Operation}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Склад"
                                            Binding="{Binding WarehouseName}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Контрагент"
                                            Binding="{Binding PartnerName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Документ"
                                            Binding="{Binding DocumentNumber}"
                                            Width="170"/>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date,
                                                StringFormat=dd.MM.yyyy}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Quantity}"
                                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Перемещения">
                <DataGrid ItemsSource="{Binding TransferRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Документ"
                                            Binding="{Binding DocumentNumber}"
                                            Width="170"/>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date,
                                                StringFormat=dd.MM.yyyy}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Откуда"
                                            Binding="{Binding SourceWarehouse}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Куда"
                                            Binding="{Binding DestinationWarehouse}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Quantity}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status}"
                                            Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Поставщики и покупатели">
                <DataGrid ItemsSource="{Binding PartnerRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding Type}"
                                            Width="140"/>
                        <DataGridTextColumn Header="Контрагент"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Документов"
                                            Binding="{Binding DocumentsCount}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Quantity}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Инвентаризация">
                <DataGrid ItemsSource="{Binding StockTakingRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Документ"
                                            Binding="{Binding DocumentNumber}"
                                            Width="170"/>
                        <DataGridTextColumn Header="Склад"
                                            Binding="{Binding WarehouseName}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Начало"
                                            Binding="{Binding StartDate,
                                                StringFormat=dd.MM.yyyy}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Завершена"
                                            Binding="{Binding CompletedDate,
                                                StringFormat=dd.MM.yyyy}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Позиций"
                                            Binding="{Binding PositionsCount}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Расхождений"
                                            Binding="{Binding DifferencesCount}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Излишки"
                                            Binding="{Binding ExcessQuantity}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Недостача"
                                            Binding="{Binding DeficitQuantity}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status}"
                                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Загруженность">
                <DataGrid ItemsSource="{Binding CapacityRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Склад"
                                            Binding="{Binding WarehouseName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Площадь"
                                            Binding="{Binding Area,
                                                StringFormat=0.##}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Ячеек"
                                            Binding="{Binding LocationsCount}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Вместимость"
                                            Binding="{Binding Capacity}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Хранится"
                                            Binding="{Binding Stored}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Свободно"
                                            Binding="{Binding Free}"
                                            Width="100"/>
                        <DataGridTemplateColumn Header="Загруженность"
                                                Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="20"
                                                     Value="{Binding LoadPercent,
                                                         Mode=OneWay}"/>
                                        <TextBlock Text="{Binding LoadPercent,
                                                       StringFormat={}{0:0.#}%}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="#2C7A2C"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>