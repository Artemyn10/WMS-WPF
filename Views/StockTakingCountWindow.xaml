<Window x:Class="WMS.Views.StockTakingCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пересчёт товаров"
        Height="620" Width="880"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">

        <!-- Низ окна: кнопки и ошибка -->
        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Сохранить и закрыть" Width="160" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                <Button Content="Завершить инвентаризацию" Width="190" Margin="0,0,8,0" Command="{Binding CompleteCommand}"/>
                <Button Content="Закрыть без сохранения" Width="170" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Верх окна: заголовок и подсказка -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding ProgressText}" Foreground="Gray" Margin="0,4,0,0"/>
            <TextBlock Text="Введите фактическое количество в колонке «Фактически». Пустая строка считается непересчитанной."
                       FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Таблица занимает всё оставшееся место -->
        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Result}" Value="Недостача">
                            <Setter Property="Background" Value="#FDEDEC"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Result}" Value="Излишек">
                            <Setter Property="Background" Value="#FEF9E7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ячейка" Binding="{Binding LocationCode}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="По учёту" Binding="{Binding Expected}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Фактически" Binding="{Binding ActualText, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Расхождение" Binding="{Binding Difference}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>