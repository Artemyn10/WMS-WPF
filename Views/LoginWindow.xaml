<Window x:Class="WMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему — WMS"
        Height="320" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WMS — Система управления складом"
                   FontSize="16" FontWeight="Bold"
                   TextWrapping="Wrap" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Логин"/>
        <TextBox Grid.Row="2" x:Name="LoginTextBox"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                 Padding="4" Margin="0,16,0,34" Grid.RowSpan="4"/>

        <TextBlock Grid.Row="4" Text="Пароль" Margin="0,10,0,6" Grid.RowSpan="2"/>
        <PasswordBox Grid.Row="5" x:Name="PasswordBox" Padding="4" Margin="0,28,0,0" Grid.RowSpan="3" Height="28" VerticalAlignment="Top"/>

        <Button Grid.Row="8" Content="Войти" Height="32"
                Command="{Binding SignInCommand}" Margin="0,55,0,-71"/>

        <TextBlock Grid.Row="7" Text="{Binding ErrorMessage}"
                   Foreground="Red" TextWrapping="Wrap"
                   HorizontalAlignment="Center" Margin="0,22,0,-34" Grid.RowSpan="2"/>
    </Grid>
</Window>