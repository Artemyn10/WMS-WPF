<UserControl x:Class="WMS.Views.StockMovementHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WMS.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="История операций" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1">

            <TabItem Header="Все операции">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Товар:" VerticalAlignment="Center"/>
                        <TextBox Width="200" Margin="8,0,0,0" Padding="4" VerticalAlignment="Center"
                                 Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Операция:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <ComboBox Width="160" Margin="8,0,0,0" Padding="4" VerticalAlignment="Center"
                                  ItemsSource="{Binding OperationTypeOptions}"
                                  SelectedItem="{Binding SelectedOperationType}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Movements}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Операция" Binding="{Binding OperationTypeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Откуда" Binding="{Binding FromLocationCode}" Width="100"/>
                            <DataGridTextColumn Header="Куда" Binding="{Binding ToLocationCode}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Поступления по складам">
                <local:ReceiptHistoryView DataContext="{Binding ReceiptHistory}" Margin="0,8,0,0"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>