<Window x:Class="WMS.Views.WriteOffEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новое списание"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">

        <!-- Низ окна: кнопки и ошибка -->
        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Провести списание" Width="150" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Верх окна: шапка документа и заголовок списка -->
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="230" Margin="0,0,16,0">
                    <TextBlock Text="Склад"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedWarehouse}" Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="130" Margin="0,0,16,0">
                    <TextBlock Text="Номер документа"/>
                    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="250">
                    <TextBlock Text="Причина списания"/>
                    <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding SelectedReason}"
                              Padding="4" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Комментарий (необязательно)" Margin="0,12,0,0"/>
            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,0"/>

            <TextBlock Text="Позиции списания" FontWeight="Bold" FontSize="14" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Товар в ячейке" Width="420" FontWeight="Bold"/>
                <TextBlock Text="Количество" Width="100" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Кнопка добавления строки -->
        <Button DockPanel.Dock="Bottom" Content="+ Добавить позицию" HorizontalAlignment="Left"
                Margin="0,8,0,0" Padding="12,4" Command="{Binding AddItemCommand}"/>

        <!-- Список позиций занимает всё оставшееся место -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox Width="420" ItemsSource="{Binding AvailableStock}"
                                      DisplayMemberPath="Display" SelectedItem="{Binding SelectedStock}"
                                      Padding="4"/>
                            <TextBox Width="80" Margin="8,0,0,0" Padding="4"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Удалить" Margin="8,0,0,0" Padding="8,4"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>