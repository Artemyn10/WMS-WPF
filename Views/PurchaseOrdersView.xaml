<UserControl x:Class="WMS.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Заказы поставщикам" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Width="200" Margin="24,0,0,0" Padding="4"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            <Button Content="Новый заказ" Margin="16,0,0,0" Padding="12,4" Command="{Binding AddCommand}"/>
            <Button Content="Отменить заказ" Margin="8,0,0,0" Padding="12,4" Command="{Binding CancelOrderCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding PurchaseOrders}"
                  SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="90"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier.Name}" Width="*"/>
                <DataGridTextColumn Header="Склад" Binding="{Binding Warehouse.Name}" Width="130"/>
                <DataGridTextColumn Header="Ожидается" Binding="{Binding ExpectedDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="140"/>
                <DataGridTextColumn Header="Получено" Binding="{Binding ProgressDisplay}" Width="100"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="160"/>
                <DataGridTextColumn Header="Оформил" Binding="{Binding CreatedBy.FullName}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="Состав выбранного заказа" FontWeight="Bold" Margin="0,4,0,0"/>

        <DataGrid Grid.Row="5" ItemsSource="{Binding SelectedOrder.Items}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Product.Article}" Width="110"/>
                <DataGridTextColumn Header="Заказано" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Получено" Binding="{Binding ReceivedQuantity}" Width="100"/>
                <DataGridTextColumn Header="Осталось" Binding="{Binding Remaining}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</UserControl>