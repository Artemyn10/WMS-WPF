<UserControl x:Class="WMS.Views.MovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="Перемещение" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Товар"/>
            <ComboBox ItemsSource="{Binding Products}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedProduct}" Padding="4" Margin="0,4,0,12"/>

            <TextBlock Text="Ячейка-источник"/>
            <ComboBox ItemsSource="{Binding SourceLocations}" DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedSourceLocation}" Padding="4" Margin="0,4,0,12"/>

            <TextBlock Text="Ячейка-назначение"/>
            <ComboBox ItemsSource="{Binding TargetLocations}" DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedTargetLocation}" Padding="4" Margin="0,4,0,12"/>

            <TextBlock Text="Количество"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,16"/>

            <Button Content="Переместить" Padding="16,6" HorizontalAlignment="Left" Command="{Binding MoveCommand}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>