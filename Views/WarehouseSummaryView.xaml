<UserControl x:Class="WMS.Views.WarehouseSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Сводка по складам" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Обновить" Margin="24,0,0,0" Padding="12,4" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Margin="0,12,0,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="150" Height="70" Margin="0,0,12,12"
                            Background="#2C3E50" CornerRadius="6">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="12"
                                       Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2">
            <TabItem Header="Загруженность">
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Склад" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Ячеек" Binding="{Binding LocationsCount}" Width="80"/>
                        <DataGridTextColumn Header="Вместимость" Binding="{Binding Capacity}" Width="110"/>
                        <DataGridTextColumn Header="Хранится" Binding="{Binding Stored}" Width="100"/>
                        <DataGridTextColumn Header="Свободно" Binding="{Binding Free}" Width="100"/>
                        <DataGridTemplateColumn Header="Загруженность" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <ProgressBar Minimum="0" Maximum="100" Height="20"
                                                     Value="{Binding LoadPercent, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding LoadPercent, StringFormat='{}{0:0.#}%'}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Деятельность">
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Склад" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Сотрудников" Binding="{Binding EmployeesCount}" Width="110"/>
                        <DataGridTextColumn Header="Приёмок" Binding="{Binding ReceiptsCount}" Width="100"/>
                        <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="100"/>
                        <DataGridTextColumn Header="Активных заказов" Binding="{Binding ActiveOrdersCount}" Width="140"/>
                        <DataGridTextColumn Header="Отгрузок" Binding="{Binding ShipmentsCount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Общие сведения">
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Склад" Binding="{Binding Name}" Width="140"/>
                        <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="200"/>
                        <DataGridTextColumn Header="Площадь, м²" Binding="{Binding Area, StringFormat='{}{0:0.##}'}" Width="100"/>
                        <DataGridTextColumn Header="Назначение" Binding="{Binding Purpose}" Width="180"/>
                        <DataGridTextColumn Header="Режим работы" Binding="{Binding WorkingHours}" Width="190"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="170"/>
                        <DataGridTextColumn Header="Ответственные" Binding="{Binding ResponsibleNames}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>