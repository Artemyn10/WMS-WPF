<UserControl x:Class="WMS.Views.WarehouseTransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Межскладские перемещения"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Создать документ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Width="230" Margin="0,0,12,8">
                            <TextBlock Text="Склад-отправитель"/>
                            <ComboBox Margin="0,4,0,0"
                                      Padding="4"
                                      ItemsSource="{Binding SourceWarehouses}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedSourceWarehouse}"/>
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,8">
                            <TextBlock Text="Склад-получатель"/>
                            <ComboBox Margin="0,4,0,0"
                                      Padding="4"
                                      ItemsSource="{Binding DestinationWarehouses}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedDestinationWarehouse}"/>
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,12,8">
                            <TextBlock Text="Ответственный отправителя"/>
                            <ComboBox Margin="0,4,0,0"
                                      Padding="4"
                                      ItemsSource="{Binding SourceStaff}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedSourceStaff}"/>
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,12,8">
                            <TextBlock Text="Ответственный получателя"/>
                            <ComboBox Margin="0,4,0,0"
                                      Padding="4"
                                      ItemsSource="{Binding DestinationStaff}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedDestinationStaff}"/>
                        </StackPanel>

                        <StackPanel Width="180" Margin="0,0,12,8">
                            <TextBlock Text="Планируемая доставка"/>
                            <DatePicker Margin="0,4,0,0"
                                        SelectedDate="{Binding PlannedDeliveryDate}"/>
                        </StackPanel>
                    </WrapPanel>

                    <Separator Grid.Row="1" Margin="0,4,0,8"/>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel Width="260" Margin="0,0,12,8">
                            <TextBlock Text="Товар"/>
                            <ComboBox Margin="0,4,0,0"
                                      Padding="4"
                                      ItemsSource="{Binding Products}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedProduct}"/>
                        </StackPanel>

                        <StackPanel Width="200" Margin="0,0,12,8">
                            <TextBlock Text="Ячейка отправителя"/>
                            <ComboBox Margin="0,4,0,0"
                                      Padding="4"
                                      ItemsSource="{Binding SourceLocations}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedSourceLocation}"/>
                        </StackPanel>

                        <StackPanel Width="200" Margin="0,0,12,8">
                            <TextBlock Text="Ячейка получателя"/>
                            <ComboBox Margin="0,4,0,0"
                                      Padding="4"
                                      ItemsSource="{Binding DestinationLocations}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedDestinationLocation}"/>
                        </StackPanel>

                        <StackPanel Width="110" Margin="0,0,12,8">
                            <TextBlock Text="Количество"/>
                            <TextBox Margin="0,4,0,0"
                                     Padding="4"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <Button Content="Добавить позицию"
                                Margin="0,20,0,8"
                                Padding="12,5"
                                Command="{Binding AddItemCommand}"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding DraftItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар"
                                                Binding="{Binding ProductDisplay}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Ячейка отправителя"
                                                Binding="{Binding SourceLocationCode}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Ячейка получателя"
                                                Binding="{Binding DestinationLocationCode}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Количество"
                                                Binding="{Binding Quantity}"
                                                Width="100"/>
                            <DataGridTemplateColumn Header="Удалить" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Удалить"
                                                Padding="4,2"
                                                Command="{Binding DataContext.RemoveItemCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="4"
                            Content="Создать документ"
                            HorizontalAlignment="Left"
                            Padding="16,6"
                            Command="{Binding CreateCommand}"/>
                </Grid>
            </TabItem>

            <TabItem Header="История и подтверждения">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Transfers}"
                              SelectedItem="{Binding SelectedTransfer}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Документ"
                                                Binding="{Binding DocumentNumber}"
                                                Width="170"/>
                            <DataGridTextColumn Header="Создан"
                                                Binding="{Binding CreatedAtLocal,
                                                    StringFormat=dd.MM.yyyy HH:mm}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Отправитель"
                                                Binding="{Binding SourceWarehouse.Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Получатель"
                                                Binding="{Binding DestinationWarehouse.Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Доставка"
                                                Binding="{Binding PlannedDeliveryDate,
                                                    StringFormat=dd.MM.yyyy}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding StatusDisplay}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1"
                               Text="Позиции выбранного документа"
                               FontWeight="Bold"
                               Margin="0,8,0,4"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SelectedTransfer.Items}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар"
                                                Binding="{Binding Product.Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Артикул"
                                                Binding="{Binding Product.Article}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Откуда"
                                                Binding="{Binding SourceStorageLocation.Code}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Куда"
                                                Binding="{Binding DestinationStorageLocation.Code}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Количество"
                                                Binding="{Binding Quantity}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <Button Content="Подтвердить отправку"
                                Padding="12,5"
                                Margin="0,0,8,0"
                                Command="{Binding ConfirmShipmentCommand}"/>
                        <Button Content="Подтвердить получение"
                                Padding="12,5"
                                Margin="0,0,8,0"
                                Command="{Binding ConfirmReceiptCommand}"/>
                        <Button Content="Печать документа"
                                Padding="12,5"
                                Click="PrintTransfer_Click"/>
                        <Button Content="Обновить"
                                Padding="12,5"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>

        <TextBlock Grid.Row="3"
                   Text="{Binding Message}"
                   Foreground="Green"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>
    </Grid>
</UserControl>