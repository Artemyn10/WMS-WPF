<Window x:Class="WMS.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="740" Width="860" MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">

        <!-- Низ окна: кнопки и ошибка -->
        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Сохранить" Width="110" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: основные данные -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Название"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Артикул"/>
                    <TextBox Text="{Binding Article, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Штрихкод"/>
                    <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Категория"/>
                    <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCategory}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Вид номенклатуры"/>
                    <ComboBox ItemsSource="{Binding ProductTypes}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedProductType}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Единица измерения"/>
                    <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Год выпуска"/>
                    <TextBox Text="{Binding ReleaseYear, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Производитель"/>
                    <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Основной поставщик"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSupplier}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Закупочная стоимость, руб."/>
                    <TextBox Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

                    <TextBlock Text="Учётная стоимость, руб."/>
                    <TextBox Text="{Binding AccountingPriceText, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Правая колонка: характеристики, описание, файлы -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Характеристики"/>
                    <TextBox Text="{Binding Characteristics, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4" Margin="0,4,0,10" Height="100"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Описание"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4" Margin="0,4,0,10" Height="70"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Фотографии и документация" FontWeight="Bold"/>
                    <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" Height="120" Margin="0,4,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип" Binding="{Binding KindDisplay}" Width="80"/>
                            <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeDisplay}" Width="70"/>
                            <DataGridTextColumn Header="" Binding="{Binding StatusDisplay}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Добавить фото" Padding="8,3" Margin="0,0,6,6" Command="{Binding AddPhotoCommand}"/>
                        <Button Content="Добавить документ" Padding="8,3" Margin="0,0,6,6" Command="{Binding AddDocumentCommand}"/>
                        <Button Content="Открыть" Padding="8,3" Margin="0,0,6,6" Command="{Binding OpenFileCommand}"/>
                        <Button Content="Удалить" Padding="8,3" Margin="0,0,6,6" Command="{Binding RemoveFileCommand}"/>
                    </WrapPanel>

                    <TextBlock Text="Файлы сохраняются вместе с товаром. Максимальный размер файла: 10 МБ."
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>

                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Height="150" Margin="0,8,0,0">
                        <Image Source="{Binding Preview}" Stretch="Uniform"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>