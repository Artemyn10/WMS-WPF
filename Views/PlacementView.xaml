<UserControl x:Class="WMS.Views.PlacementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Размещение" FontSize="20" FontWeight="Bold"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding PendingItems}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Приёмка" Binding="{Binding ReceiptNumber}" Width="100"/>
                <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="140"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="100"/>
                <DataGridTextColumn Header="Принято" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Размещено" Binding="{Binding PlacedQuantity}" Width="90"/>
                <DataGridTextColumn Header="Осталось" Binding="{Binding Remaining}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Нет товаров, ожидающих размещения."
                   FontSize="16" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12"
                BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Размещение выбранной позиции" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Width="300">
                        <TextBlock Text="Ячейка"/>
                        <ComboBox ItemsSource="{Binding Locations}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedLocation}" Padding="4" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Width="100" Margin="16,0,0,0">
                        <TextBlock Text="Количество"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="Разместить" Margin="16,0,0,0" Padding="16,5"
                            VerticalAlignment="Bottom" Command="{Binding PlaceCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>