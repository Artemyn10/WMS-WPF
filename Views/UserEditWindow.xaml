<Window x:Class="WMS.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Логин"/>
        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBoxControl" Padding="4" Margin="0,4,0,0"
                     PasswordChanged="PasswordBoxControl_OnPasswordChanged"/>
        <TextBlock Text="{Binding PasswordHint}" FontSize="11" Foreground="Gray" Margin="0,2,0,10"/>

        <TextBlock Text="ФИО"/>
        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,10"/>

        <TextBlock Text="Роль"/>
        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedRole}" Padding="4" Margin="0,4,0,10"/>

        <TextBlock Text="Склад"/>
        <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedWarehouse}" Padding="4" Margin="0,4,0,0"/>
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,10"
                   Text="Обязателен для заведующего складом. Для кладовщика и специалиста по инвентаризации ограничивает работу одним складом (если не выбран - доступны все склады). Для остальных ролей игнорируется."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
</Window>