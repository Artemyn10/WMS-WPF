<Window x:Class="WMS.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="440" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Логин"/>
        <TextBox Grid.Row="1" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Text="Пароль"/>
        <PasswordBox Grid.Row="3" x:Name="PasswordBoxControl" Padding="4"
             PasswordChanged="PasswordBoxControl_OnPasswordChanged"/>
        <TextBlock Grid.Row="4" Text="{Binding PasswordHint}" FontSize="11" Foreground="Gray" Margin="0,2,0,8"/>

        <TextBlock Grid.Row="6" Text="ФИО"/>
        <TextBox Grid.Row="7" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="8" Text="Роль"/>
        <ComboBox Grid.Row="9" ItemsSource="{Binding Roles}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedRole}" Padding="4"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Отмена" Width="100" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="13" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
    </Grid>
</Window>